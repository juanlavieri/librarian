{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juanlavieri/librarian/benchmarks/artifact.schema.json",
  "title": "Librarian benchmark run",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "git_commit",
    "runtime",
    "dataset",
    "config",
    "results",
    "failures"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "git_commit": {"type": "string"},
    "runtime": {"type": "object"},
    "dataset": {
      "type": "object",
      "required": ["name", "corpus_records", "queries", "qrels", "metadata"]
    },
    "config": {"type": "object"},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "metrics", "per_query", "rankings", "operational"]
      }
    },
    "failures": {"type": "array"},
    "comparisons_to_baseline": {"type": "object"}
  },
  "additionalProperties": true
}
